      <!-- 页面头 -->
      <header class="page-head">
        <div>
          <h1 class="ttl">项目</h1>
          <p class="sub">按代码仓库划分的记忆命名空间 · 6 个项目</p>
        </div>
        <div class="page-head__ctrls">
          <button class="btn btn--secondary"><svg class="icon"><use href="#i-refresh"/></svg>重扫目录</button>
          <button class="btn btn--primary"><svg class="icon"><use href="#i-plus"/></svg>新建项目</button>
        </div>
      </header>

      <!-- 汇总条 -->
      <section class="summary" aria-label="项目汇总">
        <div class="summary__i"><span class="summary__k">项目总数</span><span class="summary__v">6</span></div>
        <span class="summary__sep" aria-hidden="true"></span>
        <div class="summary__i"><span class="summary__k">活跃</span><span class="summary__v">4</span></div>
        <div class="summary__i"><span class="summary__k">已归档</span><span class="summary__v">2</span></div>
        <span class="summary__sep" aria-hidden="true"></span>
        <div class="summary__i"><span class="summary__k">记忆条目</span><span class="summary__v">1,284</span></div>
        <div class="summary__i"><span class="summary__k">关联会话</span><span class="summary__v">84</span></div>
        <span class="summary__sep" aria-hidden="true"></span>
        <div class="summary__i"><span class="summary__k">最近活跃</span><span class="summary__v">12<small> 分钟前</small></span></div>
      </section>

      <!-- 过滤条 -->
      <div class="bar">
        <div class="seg" role="tablist">
          <button class="is-active" type="button">全部 6</button>
          <button type="button">活跃 4</button>
          <button type="button">归档 2</button>
        </div>
        <div class="search--sm">
          <svg class="icon"><use href="#i-search"/></svg>
          <input type="text" placeholder="按项目名或路径过滤…" aria-label="过滤项目" />
        </div>
        <button class="select" type="button">排序：最近活跃 <svg class="icon"><use href="#i-chev-down"/></svg></button>
        <span class="spacer"></span>
        <span class="bar__count">显示 6 / 6</span>
      </div>

