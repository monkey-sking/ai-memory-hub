{
  "memoryDir": "%USERPROFILE%\\.ai-memory",
  "sync": {
    "archiveIndexedInboxItems": true,
    "snapshotLimit": 200,
    "lockStaleMs": 120000,
    "backupRetention": {
      "enabled": true,
      "maxCount": 50,
      "maxAgeDays": 0
    }
  },
  "tools": {
    "hermes": {
      "enabled": true
    },
    "codex": {
      "enabled": true
    },
    "claude": {
      "enabled": true
    },
    "gemini": {
      "enabled": true
    },
    "qclaw": {
      "enabled": true
    }
  }
}
